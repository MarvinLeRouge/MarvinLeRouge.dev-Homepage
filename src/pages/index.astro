---
import Home from '../components/Home.astro';
import PersonData from '../components/PersonData.astro';
import { HOME_PATHS } from '../i18n/locales';
import { UI } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';

const { title, ...meta } = UI.fr.homeMeta;
---

<BaseLayout
  title={title}
  locale="fr"
  translations={HOME_PATHS}
  meta={{ ...meta, image: '/og/home-fr.png' }}
>
  <PersonData slot="head" locale="fr" />
  <Home locale="fr" />
</BaseLayout>
