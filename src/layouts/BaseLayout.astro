---
import bebasNeueLatin from '../assets/fonts/bebas-neue-latin.woff2?url';
import shareTechMonoLatin from '../assets/fonts/share-tech-mono-latin.woff2?url';
import { DEFAULT_LOCALE, type Locale } from '../i18n/locales';
// Bundled as a standalone classic script (no imports left), so it can block rendering in the head:
// a stored language preference redirects before the first paint, without inline code (CSP).
// The dev server serves it as an ES module instead, hence the module type in dev only.
import languagePreferenceScript from '../scripts/language-preference-entry.ts?worker&url';
import '../styles/fonts.css';
import '../styles/index.css';

interface Props {
  title: string;
  locale: Locale;
  /** Path of this page in every locale, when it is translated. Emits hreflang alternates. */
  translations?: Readonly<Record<Locale, string>>;
}

const { title, locale, translations } = Astro.props;
const absolute = (path: string) => new URL(path, Astro.site).href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script
      is:inline
      src={languagePreferenceScript}
      type={import.meta.env.DEV ? 'module' : undefined}
    ></script>
    <title>{title}</title>
    <link rel="preload" href={bebasNeueLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={shareTechMonoLatin} as="font" type="font/woff2" crossorigin />
    {translations && (
      <>
        {Object.entries(translations).map(([hreflang, path]) => (
          <link rel="alternate" hreflang={hreflang} href={absolute(path)} />
        ))}
        <link rel="alternate" hreflang="x-default" href={absolute(translations[DEFAULT_LOCALE])} />
      </>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
